{
  "schema": "comotion.parameter_sweep.v1",
  "description": "Paired 90-second comparison of full restart and selective AO-ARC at repair-history depths 0, 1, and 2, including 25% random full restarts at depths 0, 1, and 2 and 50% random full restarts at depth 0, on all five Panda Cage n=4 tasks.",
  "defaults": {
    "collision_backend": "vamp",
    "resolution": 128,
    "trials_per_param_set": 10,
    "methods": [
      "ao_arc"
    ],
    "base_params": {
      "vamp_validation_strategy": "combined_rake",
      "arc_initial_window": 20,
      "arc_expansion_step": 1.05,
      "arc_expansion_policy": "exponential",
      "arc_initial_valid_expansion_policy": "linear",
      "arc_initial_valid_expansion_step": 20,
      "arc_initial_valid_expansion_symmetric": false,
      "arc_local_composite_max_samples": 250000,
      "arc_local_composite_use_makespan_metric": true,
      "arc_local_solvers": "composite",
      "arc_simplify_initial_solutions": true,
      "arc_simplify_conflict_solutions": false,
      "ao_arc_local_bound_epsilon_timesteps": 1,
      "ao_arc_selective_initial_conflict_scan": true
    }
  },
  "apps": {
    "panda_cage_n4_task0": {
      "title": "Panda Cage n=4, task 0",
      "executable": "panda_cage",
      "args": [
        "--num-robots",
        "4",
        "--task-index",
        "0",
        "--task-generation-seed",
        "0"
      ],
      "time_limit": 90.0,
      "param_grid": {
        "ao_arc": {
          "sets": [
            {
              "name": "full_restart",
              "params": {
                "ao_arc_selective_replanning": false,
                "ao_arc_expand_replanning_from_repair_history": false
              }
            },
            {
              "name": "violators_only",
              "params": {
                "ao_arc_selective_replanning": true,
                "ao_arc_expand_replanning_from_repair_history": false
              }
            },
            {
              "name": "history_one_hop",
              "params": {
                "ao_arc_selective_replanning": true,
                "ao_arc_expand_replanning_from_repair_history": true
              }
            },
            {
              "name": "history_two_hop",
              "params": {
                "ao_arc_selective_replanning": true,
                "ao_arc_repair_history_replanning_depth": 2
              }
            },
            {
              "name": "history_one_hop_random_25",
              "params": {
                "ao_arc_selective_replanning": true,
                "ao_arc_repair_history_replanning_depth": 1,
                "ao_arc_random_full_restart_probability": 0.25
              }
            },
            {
              "name": "history_two_hop_random_25",
              "params": {
                "ao_arc_selective_replanning": true,
                "ao_arc_repair_history_replanning_depth": 2,
                "ao_arc_random_full_restart_probability": 0.25
              }
            },
            {
              "name": "violators_only_random_25",
              "params": {
                "ao_arc_selective_replanning": true,
                "ao_arc_repair_history_replanning_depth": 0,
                "ao_arc_random_full_restart_probability": 0.25
              }
            },
            {
              "name": "violators_only_random_50",
              "params": {
                "ao_arc_selective_replanning": true,
                "ao_arc_repair_history_replanning_depth": 0,
                "ao_arc_random_full_restart_probability": 0.5
              }
            }
          ]
        }
      }
    },
